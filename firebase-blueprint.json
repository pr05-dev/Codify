{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and progress data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "cPoints": { "type": "number", "description": "Coding points" },
        "bPoints": { "type": "number", "description": "Doubt points" },
        "easyTestsDone": { "type": "number" },
        "completedQuestions": { "type": "array", "items": { "type": "string" } },
        "solvedHistory": { "type": "array", "items": { "type": "object" } },
        "codePathProgress": {
          "type": "object",
          "description": "Progress mapping for CodePath beginner roadmap per language"
        },
        "careerRoadmaps": {
          "type": "object",
          "description": "Custom career roadmaps generated by user containing pillars, checked subnodes, and ascii tree representation"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "HistoryCacheRecord": {
      "title": "HistoryCacheRecord",
      "description": "Deeply serialized immutable cache record of module completions and test submissions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID who completed the module or submitted the test" },
        "timestamp": { "type": "string", "format": "date-time" },
        "actionType": { "type": "string", "enum": ["module_completed", "test_submitted"] },
        "payload": { "type": "object", "description": "Deeply serialized action details (e.g. code, points, topic, status)" },
        "strategy": { "type": "string", "enum": ["immutable-append"] },
        "lifecycle": { "type": "string", "enum": ["permanent_cache"] }
      },
      "required": ["userId", "timestamp", "actionType", "payload", "strategy", "lifecycle"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Individual user documents"
    },
    "/user_history_cache/{recordId}": {
      "schema": "HistoryCacheRecord",
      "description": "Immutable append-only logs for persistent queryable user history cache"
    }
  }
}
